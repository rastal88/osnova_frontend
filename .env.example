# Copy to .env.local and adjust. Every variable is optional.
#
# Everything here is PUBLIC: Vite inlines VITE_* values into the JavaScript bundle,
# so any visitor can read them. Never put secrets (API keys, tokens, passwords)
# in frontend env files — keep them on the backend.
#
# Files Vite reads, later ones win: .env, .env.local, .env.[mode], .env.[mode].local.
# Only this example is committed; the others are ignored by git.

# Backend API (default: http://localhost:8000/api/v1; Docker uses /api/v1)
VITE_BASE_URL=http://localhost:8000/api/v1

# --- SEO and link previews (see DEVELOPMENT.md, "SEO and link previews") ---
# Public site origin for canonical, hreflang, og:url and sitemap.xml
VITE_SITE_URL=
# Default preview image: absolute URL or a path in public/, e.g. /og.png
VITE_OG_IMAGE=

# Build-time prerender: backend API to read languages from /bootstrap
# (default: VITE_BASE_URL when it is an absolute URL)
PRERENDER_API_URL=
# Fallback when the backend is not reachable during the build
VITE_LANGUAGES=
VITE_DEFAULT_LANGUAGE=
VITE_APP_NAME=
