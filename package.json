{
  "name": "osnova_frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "biome check .",
    "preview": "vite preview",
    "format": "biome check --write .",
    "generate:client": "openapi-ts",
    "images": "node scripts/images.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.24.5",
    "axios": "^1.8.4",
    "i18next": "^26.7.2",
    "qs": "^6.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
